// OncoPlan – Datenmodell (PostgreSQL)
// Basis: CLAUDE.md / OncoPlan_Spezifikation.md. Ergänzungen sind mit "Ergänzung" markiert.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

enum AlertLevel {
  YELLOW
  RED
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

/// Ergänzung: Art eines Termins (Anzeige-Labels im Frontend)
enum AppointmentType {
  BLOOD_DRAW
  CHEMOTHERAPY
  CONSULTATION
  IMAGING
  OTHER
}

model User {
  id                  String             @id @default(uuid())
  email               String             @unique
  passwordHash        String
  /// Ergänzung: true nach Vergabe eines Startpassworts – erzwingt eigenes Passwort beim nächsten Login
  mustChangePassword  Boolean            @default(false)
  role                UserRole
  firstName           String
  lastName            String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  patientProfile      PatientProfile?    @relation("PatientToUser")
  doctorAlerts        TriageAlert[]      @relation("DoctorToAlerts")
  assignedPatients    PatientProfile[]   @relation("DoctorToPatients")
  createdAppointments Appointment[]      @relation("DoctorToAppointments")
  pushSubscriptions   PushSubscription[]

  @@map("users")
}

model PatientProfile {
  id               String           @id @default(uuid())
  userId           String           @unique
  user             User             @relation("PatientToUser", fields: [userId], references: [id], onDelete: Cascade)
  birthDate        DateTime         @db.Date
  cancerType       String
  therapyStart     DateTime         @db.Date
  assignedDoctorId String?
  assignedDoctor   User?            @relation("DoctorToPatients", fields: [assignedDoctorId], references: [id])
  /// Ergänzung: Rückrufnummer für "Anrufen" im Dashboard. AES-256-GCM verschlüsselt (CryptoVault).
  phoneEncrypted   String?
  createdAt        DateTime         @default(now())
  symptomLogs      SymptomLog[]
  medicationPlans  MedicationPlan[]
  triageAlerts     TriageAlert[]
  appointments     Appointment[]

  @@index([assignedDoctorId])
  @@map("patient_profiles")
}

model SymptomLog {
  id           String         @id @default(uuid())
  patientId    String
  patient      PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  loggedAt     DateTime       @default(now())
  feverCelsius Float
  painLevel    Int
  nauseaLevel  Int
  /// Ergänzung: Durchfall ja/nein (Check-in-Frage 4)
  diarrhea     Boolean        @default(false)
  /// AES-256-GCM verschlüsselt (Format iv:authTag:ciphertext)
  symptomNotes String?
  syncStatus   String         @default("synced")
  /// Ergänzung: clientseitige UUID für idempotenten Offline-Sync (verhindert Duplikate bei Wiederholung)
  clientRef    String?        @unique
  triageAlerts TriageAlert[]

  @@index([patientId, loggedAt])
  @@map("symptom_logs")
}

model MedicationPlan {
  id             String             @id @default(uuid())
  patientId      String
  patient        PatientProfile     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicationName String
  dosage         String
  /// Tägliche Einnahmezeiten im Cron-Format "M H * * *" (H darf eine Liste sein, z. B. "0 8,20 * * *")
  frequencyCron  String
  /// Ergänzung: Einnahmehinweis für Patient:innen, z. B. "nach dem Frühstück"
  hint           String?
  startDate      DateTime           @db.Date
  endDate        DateTime           @db.Date
  intakes        MedicationIntake[]

  @@index([patientId])
  @@map("medication_plans")
}

/// Ergänzung: bestätigte Einnahmen (Abhaken im Einnahmeplan der Patienten-App)
model MedicationIntake {
  id          String         @id @default(uuid())
  planId      String
  plan        MedicationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// Geplanter Einnahmezeitpunkt (Datum + Uhrzeit aus dem Cron-Ausdruck)
  scheduledAt DateTime
  takenAt     DateTime       @default(now())

  @@unique([planId, scheduledAt])
  @@map("medication_intakes")
}

model TriageAlert {
  id             String         @id @default(uuid())
  patientId      String
  patient        PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  symptomLogId   String?
  symptomLog     SymptomLog?    @relation(fields: [symptomLogId], references: [id])
  level          AlertLevel
  status         AlertStatus    @default(ACTIVE)
  triggerReason  String
  acknowledgedBy String?
  doctor         User?          @relation("DoctorToAlerts", fields: [acknowledgedBy], references: [id])
  /// Ergänzung: Zeitpunkt der Quittierung ("Bestätigt von … · heute hh:mm")
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())

  @@index([patientId, status])
  @@map("triage_alerts")
}

/// Ergänzung: Termine, die Ärzt:innen vergeben (Blutabnahme, Chemotherapie …)
model Appointment {
  id             String          @id @default(uuid())
  patientId      String
  patient        PatientProfile  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type           AppointmentType
  startsAt       DateTime
  /// z. B. "Tagesklinik Onkologie, Ebene 7"
  location       String?
  /// Nur bei Blutabnahme: Patient:in soll nüchtern erscheinen
  fasting        Boolean         @default(false)
  /// Hinweis für Patient:innen, z. B. "Überweisung mitbringen". AES-256-GCM verschlüsselt (CryptoVault).
  noteEncrypted  String?
  createdById    String?
  createdBy      User?           @relation("DoctorToAppointments", fields: [createdById], references: [id], onDelete: SetNull)
  /// Zeitpunkt der 24-h-Erinnerung; wird bei Terminverschiebung zurückgesetzt
  reminderSentAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([patientId, startsAt])
  @@index([reminderSentAt, startsAt])
  @@map("appointments")
}

/// Ergänzung: Web-Push-Abonnements (ein Eintrag pro Gerät/Browser)
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}
